<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <TextView
        android:paddingTop="25dp"
        android:id="@+id/textt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:text="Рассчет чека"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:paddingTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/textt"
        android:layout_marginTop="35dp"
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/sum"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Сумма счета"
            android:inputType="numberDecimal"/>
        <EditText
            android:id="@+id/chai"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Процент чаевых - 15%"
            android:inputType="number"/>
        <EditText
            android:id="@+id/colvo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Кол-во человек"
            android:inputType="number"/>
        <RadioGroup
            android:id="@+id/zp"
            android:checkedButton="@id/blij">

            <RadioButton
                android:id="@+id/mensh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Округление в меньшую сторону" />
            <RadioButton
                android:id="@+id/bolsh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Округление в большую сторону" />
            <RadioButton
                android:id="@+id/blij"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Округление в ближайшую сторону" />
        </RadioGroup>
    </GridLayout>
    <GridLayout
        android:id="@+id/otvet"
        app:layout_constraintTop_toBottomOf="@id/info"
        app:layout_constraintBottom_toTopOf="@id/butt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:visibility="invisible">
        <TextView
            android:id="@+id/ch"
            android:text="Сумма чаевых"
            android:textSize="17dp"
            />
        <TextView
            android:id="@+id/summ"
            android:text="Общая сумма"
            android:textSize="17dp"/>
        <TextView
            android:id="@+id/chel"
            android:text="Сумма на каждого человека"
            android:textSize="17dp"/>
    </GridLayout>
    <Button
        android:id="@+id/butt"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/info"
        android:text="Рассчитать"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>